PORT=8080
DB_PATH=./data/jellite.sqlite

# sqlite (default) serves JPEG BLOBs from the database. gcs redirects to public WebP objects.
IMAGE_HOSTING=sqlite
# Required only for IMAGE_HOSTING=gcs.
# GCS_BUCKET_NAME=jellite-covers
# GCS_COVERS_PREFIX=covers
# Optional custom public base URL, e.g. a CDN URL.
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/jellite-covers

JELLITE_USERNAME=admin
JELLITE_PASSWORD=changeme
# Generate with: openssl rand -hex 32
JELLITE_ACCESS_TOKEN=dev-insecure-token

JELLITE_SERVER_ID=jellite-server
JELLITE_SERVER_NAME=Jellite
JELLITE_USER_ID=jellite-user

# Comma-separated list of allowed origins for browser-based (CORS) clients.
# Defaults to "*" (allow any origin). Example: JELLITE_CORS_ORIGINS=https://app.example.com,https://music.example.com
# JELLITE_CORS_ORIGINS=*

# Only needed locally / when the runtime identity isn't attached automatically.
# On Cloud Run, prefer attaching the service account directly and leave this unset.
# GOOGLE_APPLICATION_CREDENTIALS=../service-account.json
