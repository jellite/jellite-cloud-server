PORT=8080
DB_PATH=./data/jellite.sqlite

JELLITE_USERNAME=admin
JELLITE_PASSWORD=changeme
# Generate with: openssl rand -hex 32
JELLITE_ACCESS_TOKEN=dev-insecure-token

